{
  "name": "agent-devis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent IA de devis menuiserie pour Idéal Aluminium, basé sur le moteur de CalculDevis",
  "scripts": {
    "test:moteur": "node scripts/test-moteur.mjs",
    "charger:catalogue": "node scripts/charger-catalogue.mjs",
    "test:rappels": "node scripts/test-rappels.mjs",
    "test:volet": "node scripts/test-volet.mjs",
    "discuter": "node --env-file=.env scripts/discuter.mjs",
    "test:outils": "node scripts/test-outils.mjs",
    "test:agent": "node scripts/test-agent-simule.mjs",
    "test": "node scripts/test-moteur.mjs && node scripts/test-outils.mjs && node scripts/test-agent-simule.mjs && node scripts/test-stockage.mjs && node scripts/test-chantier.mjs",
    "start": "node --env-file-if-exists=.env src/serveur.js",
    "exemple": "node scripts/exemple-devis.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.3.0",
    "mathjs": "^14.0.0",
    "pdfkit": "^0.20.2"
  }
}
